# ===========================================
# PRODUCTION ENVIRONMENT - VPS DEPLOYMENT
# ===========================================

# Environment
NODE_ENV=production
COMPOSE_PROJECT_NAME=ielts-exams-prod

# Domain Configuration
SERVER_DOMAIN=domain.com

# Application Ports (internal Docker communication)
FRONTEND_PORT=3000
BACKEND_PORT=8228
BACKEND_INTERNAL_PORT=8228

# Database Configuration - Production
MYSQL_ROOT_PASSWORD=ielts_prod_pass_root
MYSQL_DATABASE=ielts_prod_db
MYSQL_USER=ielts_prod_user
MYSQL_PASSWORD=ielts_prod_pass

# Prisma Database URL
DATABASE_URL="mysql://ielts_prod_user:2000ielts@mysql:3306/ielts_prod_db"

# JWT Configuration - Production (RSA Keys)
# RSA keys should be generated securely and stored in keys/ directory
# Use environment variables or key management services for production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Configuration
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_API_URL=/api  # API calls qua nginx proxy
NEXT_PUBLIC_APP_URL=http://localhost:3000  # Internal Docker URL

# Backend Configuration
BACKEND_API_URL=http://backend:8228  # Docker internal network
FRONTEND_URL=http://frontend:3000
CORS_ORIGIN=domain.com