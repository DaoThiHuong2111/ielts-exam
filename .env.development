# ===========================================
# DEVELOPMENT ENVIRONMENT
# ===========================================

# Environment
NODE_ENV=development
COMPOSE_PROJECT_NAME=ielts-exams-dev

# VPS Configuration
SERVER_DOMAIN=localhost

# Application Ports
FRONTEND_PORT=3000
BACKEND_PORT=8228
BACKEND_INTERNAL_PORT=8228
PHPMYADMIN_PORT=8081

# Database Configuration - Development
MYSQL_ROOT_PASSWORD=dev_root_password_123
MYSQL_DATABASE=ielts_dev_db
MYSQL_USER=ielts_dev_user
MYSQL_PASSWORD=dev_password_123

# Prisma Database URL
DATABASE_URL="mysql://ielts_dev_user:dev_password_123@localhost:3306/ielts_dev_db"

# JWT Configuration - Development (RSA Keys)
# RSA keys are generated by ./generate-keys.sh and stored in keys/ directory
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Development Tools
ENABLE_PHPMYADMIN=true

# Frontend Configuration (Docker + Local)
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_API_URL=/api  # API calls qua nginx proxy (Docker) hoặc direct (Local)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend Configuration
BACKEND_API_URL=http://backend:8228  # Docker internal network
FRONTEND_URL=http://frontend:3000
CORS_ORIGIN=http://frontend:3000